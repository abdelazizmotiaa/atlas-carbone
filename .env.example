# Atlas Carbone - Variables d'environnement d'exemple (.env.example)
# Aucune clé secrète ou mot de passe de production ne doit être consigné dans ce fichier.

# Environnement
NODE_ENV=development
PORT=5000
TZ=Africa/Casablanca

# Sécurité & Tokens JWT (à remplacer impérativement par une clé aléatoire forte en production)
JWT_SECRET=votre_cle_secrete_jwt_complexe_ici_min_32_caracteres

# Base de Données
DB_FILE=./data/atlas_carbone.db

# Paramètres Commerciaux par Défaut (Dirhams Marocains)
DEFAULT_CURRENCY=MAD
DEFAULT_TVA_RATE=0.20

# Configuration SMTP (Optionnelle - en local les emails sont capturés dans dev_notifications)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Atlas Carbone <contact@atlascarbone.ma>"
